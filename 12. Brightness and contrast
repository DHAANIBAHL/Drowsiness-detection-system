# 12. Brightness and contrast
open_bright     = [img.mean() for img in open_imgs]
closed_bright   = [img.mean() for img in closed_imgs]
open_contrast   = [img.std()  for img in open_imgs]
closed_contrast = [img.std()  for img in closed_imgs]

fig, axes = plt.subplots(1, 2, figsize=(13, 4))
fig.suptitle('Brightness and Contrast Per Image', fontsize=13, fontweight='bold')

axes[0].hist(open_bright,   bins=20, alpha=0.7, color='steelblue',
             label=f'Open, mean={np.mean(open_bright):.1f}')
axes[0].hist(closed_bright, bins=20, alpha=0.7, color='tomato',
             label=f'Closed, mean={np.mean(closed_bright):.1f}')
axes[0].axvline(np.mean(open_bright),   color='steelblue', linestyle='--', linewidth=2)
axes[0].axvline(np.mean(closed_bright), color='tomato',    linestyle='--', linewidth=2)
axes[0].set_title('Brightness')
axes[0].set_xlabel('Mean Pixel Value')
axes[0].set_ylabel('Number of Images')
axes[0].legend()

axes[1].hist(open_contrast,   bins=20, alpha=0.7, color='steelblue', label='Open')
axes[1].hist(closed_contrast, bins=20, alpha=0.7, color='tomato',    label='Closed')
axes[1].set_title('Contrast')
axes[1].set_xlabel('Std of Pixel Values')
axes[1].set_ylabel('Number of Images')
axes[1].legend()

plt.tight_layout()
plt.show()

very_dark   = sum(1 for b in open_bright + closed_bright if b < 20)
very_bright = sum(1 for b in open_bright + closed_bright if b > 230)
print(f"Very dark images, mean below 20  : {very_dark}")
print(f"Very bright images, mean above 230: {very_bright}")
