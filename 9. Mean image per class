# 9. Mean image per class
mean_open   = np.mean(open_imgs, axis=0)
mean_closed = np.mean(closed_imgs, axis=0)

fig, axes = plt.subplots(1, 2, figsize=(10, 4))
fig.suptitle('Mean Image Per Class', fontsize=13, fontweight='bold')

axes[0].imshow(mean_open,   cmap='gray', vmin=0, vmax=255)
axes[0].set_title(f'Open Eye, mean pixel: {mean_open.mean():.1f}')
axes[0].axis('off')

axes[1].imshow(mean_closed, cmap='gray', vmin=0, vmax=255)
axes[1].set_title(f'Closed Eye, mean pixel: {mean_closed.mean():.1f}')
axes[1].axis('off')

plt.tight_layout()
plt.show()
