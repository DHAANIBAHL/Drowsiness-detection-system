# 10. Pixel variance map
var_open   = np.var(open_imgs,   axis=0)
var_closed = np.var(closed_imgs, axis=0)

fig, axes = plt.subplots(1, 2, figsize=(10, 4))
fig.suptitle('Pixel Variance Map', fontsize=13, fontweight='bold')

im0 = axes[0].imshow(var_open,   cmap='hot')
axes[0].set_title('Open Eye Variance')
axes[0].axis('off')
plt.colorbar(im0, ax=axes[0], fraction=0.046)

im1 = axes[1].imshow(var_closed, cmap='hot')
axes[1].set_title('Closed Eye Variance')
axes[1].axis('off')
plt.colorbar(im1, ax=axes[1], fraction=0.046)

plt.tight_layout()
plt.show()
